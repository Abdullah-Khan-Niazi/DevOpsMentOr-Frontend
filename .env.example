VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_APP_NAME=DevOps Mentor

# OAuth — must match backend env (Google Cloud Console / GitHub OAuth App)
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=

# Stripe — publishable key only; never place secret keys in the frontend
VITE_STRIPE_PUBLISHABLE_KEY=

# Labs engine static assets (slides / walkthroughs). Served by the root Labs app.
VITE_LABS_ASSETS_URL=http://localhost:5050/assets
